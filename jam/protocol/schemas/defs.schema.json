{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kickoman/QiYaa-spec/jam/protocol/schemas/defs.schema.json",
  "title": "Defs",
  "description": "Shared definitions of the jam protocol",
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,36}$"
    },
    "roomId": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{8}$"
    },
    "publicId": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{6}$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^i[1-9][0-9]{0,8}$"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_-]{1,64}$"
    },
    "joinSecret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "hostSecret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "participantId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F](?:[^\\u0000-\\u001F\\u007F]*[^\\s\\u0000-\\u001F\\u007F])?$"
    },
    "searchText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*\\S[^\\u0000-\\u001F\\u007F]*$"
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "positionMs": {
      "type": "integer",
      "minimum": 0
    },
    "joinUrl": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^https?://[^\\s#/]+(?:/[^\\s#]*)?/j/[0-9a-hjkmnp-tv-z]{8}#[A-Za-z0-9_-]{22}$"
    },
    "seed": {
      "type": "string",
      "pattern": "^track:[0-9A-Za-z_-]{1,64}$"
    },
    "reason": {
      "enum": [
        "bad-secret",
        "room-not-found",
        "room-full",
        "join-closed",
        "kicked",
        "rate-limited",
        "queue-limit",
        "duplicate",
        "not-allowed",
        "stale",
        "unknown-track",
        "track-unavailable",
        "host-offline",
        "host-timeout",
        "host-error",
        "invalid-message",
        "update-required",
        "server-full"
      ]
    },
    "participantKind": {
      "enum": [
        "host",
        "web",
        "qiyaa"
      ]
    },
    "noSecrets": {
      "$comment": "No object at any depth has a property named like a secret.",
      "if": {
        "type": "object"
      },
      "then": {
        "type": "object",
        "propertyNames": {
          "not": {
            "enum": [
              "hostKey",
              "hostSecret",
              "joinSecret",
              "participantId"
            ]
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/noSecrets"
        }
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noSecrets"
          }
        }
      }
    },
    "listenUrl": {
      "description": "The host's Yandex Music file of the track that sounds now, for guests who listen along: an https link to Yandex's storage, valid for about an hour",
      "type": "string",
      "maxLength": 400,
      "pattern": "^https://[A-Za-z0-9-]+\\.storage\\.yandex\\.net/get-mp3/[0-9a-f]{32}/[0-9a-f]{1,32}/[^\\s#?]+$"
    }
  }
}
