{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kickoman/QiYaa-spec/jam/protocol/schemas/messages/remove.schema.json",
  "title": "RemoveMessage",
  "description": "Host or guest: take an item out of the queue",
  "type": "object",
  "required": [
    "type",
    "id",
    "itemId"
  ],
  "properties": {
    "type": {
      "const": "remove"
    },
    "id": {
      "$ref": "../defs.schema.json#/$defs/requestId"
    },
    "itemId": {
      "$ref": "../defs.schema.json#/$defs/itemId"
    }
  }
}
