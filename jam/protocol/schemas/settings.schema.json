{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kickoman/QiYaa-spec/jam/protocol/schemas/settings.schema.json",
  "title": "Settings",
  "description": "Room settings",
  "type": "object",
  "required": [
    "order",
    "guestsCanSkip",
    "joinOpen",
    "maxPendingPerGuest"
  ],
  "properties": {
    "order": {
      "enum": [
        "round-robin",
        "fifo"
      ]
    },
    "guestsCanSkip": {
      "type": "boolean"
    },
    "joinOpen": {
      "type": "boolean"
    },
    "maxPendingPerGuest": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "$defs": {
    "patch": {
      "title": "SettingsPatch",
      "description": "Some of the settings",
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/properties/order"
        },
        "guestsCanSkip": {
          "$ref": "#/properties/guestsCanSkip"
        },
        "joinOpen": {
          "$ref": "#/properties/joinOpen"
        },
        "maxPendingPerGuest": {
          "$ref": "#/properties/maxPendingPerGuest"
        }
      }
    }
  }
}
