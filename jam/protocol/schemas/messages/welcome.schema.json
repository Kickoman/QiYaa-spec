{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kickoman/QiYaa-spec/jam/protocol/schemas/messages/welcome.schema.json",
  "title": "WelcomeMessage",
  "description": "Handshake accepted",
  "type": "object",
  "required": [
    "type",
    "protocol",
    "serverTime"
  ],
  "properties": {
    "type": {
      "const": "welcome"
    },
    "protocol": {
      "type": "integer",
      "minimum": 1
    },
    "serverTime": {
      "$ref": "../defs.schema.json#/$defs/time"
    }
  }
}
