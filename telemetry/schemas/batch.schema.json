{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kickoman/QiYaa-spec/telemetry/schemas/batch.schema.json",
  "title": "TelemetryBatch",
  "description": "One POST /api/telemetry: events of one machine, oldest first",
  "oneOf": [
    {
      "$ref": "#/$defs/desktopBatch"
    },
    {
      "$ref": "#/$defs/androidBatch"
    }
  ],
  "$defs": {
    "desktopBatch": {
      "title": "DesktopBatch",
      "description": "A batch of the desktop app",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "machine",
        "events"
      ],
      "properties": {
        "app": {
          "const": "desktop"
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/start"
              },
              {
                "$ref": "#/$defs/exit"
              },
              {
                "$ref": "#/$defs/crash"
              },
              {
                "$ref": "#/$defs/unclean_exit"
              },
              {
                "$ref": "#/$defs/error"
              },
              {
                "$ref": "#/$defs/feature"
              }
            ]
          }
        }
      }
    },
    "androidBatch": {
      "title": "AndroidBatch",
      "description": "A batch of the Android app",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "machine",
        "events"
      ],
      "properties": {
        "app": {
          "const": "android"
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/androidStart"
              },
              {
                "$ref": "#/$defs/androidExit"
              },
              {
                "$ref": "#/$defs/androidCrash"
              },
              {
                "$ref": "#/$defs/unclean_exit"
              },
              {
                "$ref": "#/$defs/error"
              },
              {
                "$ref": "#/$defs/feature"
              }
            ]
          }
        }
      }
    },
    "machine": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "HMAC-SHA256 of the OS machine id (Android: ANDROID_ID) with the app's key, first 16 bytes in hex"
    },
    "session": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z.+_-]{1,32}$"
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "text32": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f]{0,32}$"
    },
    "text64": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f]{0,64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "skin": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 ._-]{1,48}$",
      "description": "base, the name of a built-in skin, or custom"
    },
    "start": {
      "title": "StartEvent",
      "description": "The app started: the platform, the build and the state it starts in",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "session",
        "version",
        "os",
        "osName",
        "osVersion",
        "kernel",
        "arch",
        "qt",
        "package",
        "locale",
        "language",
        "scale",
        "screens",
        "dpr",
        "skin",
        "vis",
        "equalizer",
        "milkdropBuilt",
        "milkdropVisible",
        "jamBuilt",
        "audioBackend",
        "loggedIn",
        "firstRun"
      ],
      "properties": {
        "type": {
          "const": "start"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "os": {
          "enum": [
            "linux",
            "windows",
            "macos",
            "other"
          ]
        },
        "osName": {
          "$ref": "#/$defs/text64",
          "description": "QSysInfo::prettyProductName()"
        },
        "osVersion": {
          "$ref": "#/$defs/text32",
          "description": "QSysInfo::productVersion()"
        },
        "kernel": {
          "$ref": "#/$defs/text64",
          "description": "QSysInfo::kernelVersion()"
        },
        "arch": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,16}$"
        },
        "qt": {
          "type": "string",
          "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}\\.[0-9]{1,3}$"
        },
        "package": {
          "enum": [
            "deb",
            "appimage",
            "windows",
            "macos",
            "source"
          ]
        },
        "locale": {
          "type": "string",
          "pattern": "^(C|[a-z]{2,3}(_[A-Za-z0-9]{2,4})?)$"
        },
        "language": {
          "enum": [
            "be",
            "ru",
            "en"
          ]
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "screens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "dpr": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "skin": {
          "$ref": "#/$defs/skin"
        },
        "vis": {
          "enum": [
            "spectrum",
            "oscilloscope",
            "off"
          ]
        },
        "equalizer": {
          "type": "boolean"
        },
        "milkdropBuilt": {
          "type": "boolean"
        },
        "milkdropVisible": {
          "type": "boolean"
        },
        "jamBuilt": {
          "type": "boolean"
        },
        "audioBackend": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 _-]{0,24}$"
        },
        "loggedIn": {
          "type": "boolean"
        },
        "spotifyLoggedIn": {
          "type": "boolean",
          "description": "Logged in to Spotify (saved credentials); left out by builds before Spotify"
        },
        "firstRun": {
          "type": "boolean"
        }
      }
    },
    "exit": {
      "title": "ExitEvent",
      "description": "The app closed normally: what the session did",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "session",
        "version",
        "seconds",
        "tracks",
        "playMinutes",
        "milkdropMinutes",
        "jams",
        "errorsDropped"
      ],
      "properties": {
        "type": {
          "const": "exit"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "seconds": {
          "$ref": "#/$defs/count"
        },
        "tracks": {
          "$ref": "#/$defs/count"
        },
        "playMinutes": {
          "$ref": "#/$defs/count"
        },
        "milkdropMinutes": {
          "$ref": "#/$defs/count"
        },
        "jams": {
          "$ref": "#/$defs/count"
        },
        "errorsDropped": {
          "$ref": "#/$defs/count"
        },
        "lyricsLookups": {
          "$ref": "#/$defs/count"
        },
        "lyricsSourceSynced": {
          "$ref": "#/$defs/count"
        },
        "lyricsThirdPartySynced": {
          "$ref": "#/$defs/count"
        },
        "lyricsSourceText": {
          "$ref": "#/$defs/count"
        },
        "lyricsThirdPartyText": {
          "$ref": "#/$defs/count"
        },
        "lyricsInstrumental": {
          "$ref": "#/$defs/count"
        },
        "lyricsNone": {
          "$ref": "#/$defs/count"
        },
        "lyricsThirdPartyFailed": {
          "$ref": "#/$defs/count"
        }
      },
      "dependentRequired": {
        "lyricsLookups": [
          "lyricsSourceSynced",
          "lyricsThirdPartySynced",
          "lyricsSourceText",
          "lyricsThirdPartyText",
          "lyricsInstrumental",
          "lyricsNone",
          "lyricsThirdPartyFailed"
        ]
      }
    },
    "crash": {
      "title": "CrashEvent",
      "description": "The run named by session and version crashed; the next run sends this",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "session",
        "version",
        "signal",
        "frames",
        "seconds"
      ],
      "properties": {
        "type": {
          "const": "crash"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "signal": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
        },
        "frames": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._+-]{1,64}\\+0x[0-9a-f]{1,16}$"
          }
        },
        "seconds": {
          "$ref": "#/$defs/count"
        },
        "exceptionType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:<>, *&]{1,96}$"
        }
      }
    },
    "unclean_exit": {
      "title": "UncleanExitEvent",
      "description": "The run named by session and version neither closed nor left a crash report: killed, power lost, hung",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "session",
        "version",
        "seconds"
      ],
      "properties": {
        "type": {
          "const": "unclean_exit"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "seconds": {
          "$ref": "#/$defs/count",
          "description": "How long it ran, to the last minute it noted"
        }
      }
    },
    "error": {
      "title": "ErrorEvent",
      "description": "Something failed; a category from the table, never the text",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "session",
        "version",
        "area",
        "kind"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "area": {
          "enum": [
            "playback",
            "audio",
            "api",
            "login",
            "skin",
            "milkdrop",
            "jam",
            "spotify"
          ]
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "httpStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      }
    },
    "feature": {
      "title": "FeatureEvent",
      "description": "The user switched a feature or changed a choice",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "session",
        "version",
        "name",
        "value"
      ],
      "properties": {
        "type": {
          "const": "feature"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "name": {
          "enum": [
            "milkdrop",
            "jam",
            "skin",
            "language",
            "equalizer",
            "vis",
            "lyrics",
            "lyrics-services",
            "spotify"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 ._-]{1,48}$"
        }
      }
    },
    "androidFrame": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_$.<>-]{1,200}:[0-9]{1,7}$",
      "description": "<class>.<method>:<line> of the root cause; the line is 0 when unknown or native"
    },
    "androidStart": {
      "title": "AndroidStartEvent",
      "description": "The Android app started: the phone, the build and the state it starts in",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "session",
        "version",
        "os",
        "osVersion",
        "sdk",
        "device",
        "kernel",
        "arch",
        "package",
        "locale",
        "language",
        "dpr",
        "theme",
        "vis",
        "equalizer",
        "quality",
        "qualityMetered",
        "loggedIn",
        "firstRun"
      ],
      "properties": {
        "type": {
          "const": "start"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "os": {
          "const": "android"
        },
        "osVersion": {
          "$ref": "#/$defs/text32",
          "description": "Build.VERSION.RELEASE"
        },
        "sdk": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Build.VERSION.SDK_INT"
        },
        "device": {
          "type": "string",
          "pattern": "^[\\x20-\\x7e]{1,64}$",
          "description": "Build.MANUFACTURER and Build.MODEL, the manufacturer left out when the model starts with it"
        },
        "kernel": {
          "$ref": "#/$defs/text64",
          "description": "System.getProperty(\"os.version\")"
        },
        "arch": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,16}$",
          "description": "Build.SUPPORTED_ABIS[0]: arm64-v8a is arm64, armeabi-v7a arm, x86 i386"
        },
        "package": {
          "enum": [
            "apk",
            "debug"
          ],
          "description": "apk for a release build, debug otherwise"
        },
        "locale": {
          "type": "string",
          "pattern": "^(C|[a-z]{2,3}(_[A-Za-z0-9]{2,4})?)$",
          "description": "The system's locale, not the app's language"
        },
        "language": {
          "enum": [
            "be",
            "ru",
            "en"
          ]
        },
        "dpr": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "theme": {
          "enum": [
            "green",
            "amber",
            "ice"
          ]
        },
        "vis": {
          "enum": [
            "spectrum",
            "oscilloscope",
            "off"
          ]
        },
        "equalizer": {
          "type": "boolean"
        },
        "quality": {
          "enum": [
            "standard",
            "economy"
          ]
        },
        "qualityMetered": {
          "enum": [
            "standard",
            "economy"
          ],
          "description": "The quality on a metered network"
        },
        "loggedIn": {
          "type": "boolean"
        },
        "firstRun": {
          "type": "boolean"
        }
      }
    },
    "androidExit": {
      "title": "AndroidExitEvent",
      "description": "The Android run named by session and version ended; the next run sends this",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "session",
        "version",
        "seconds",
        "tracks",
        "playMinutes",
        "jams",
        "errorsDropped"
      ],
      "properties": {
        "type": {
          "const": "exit"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "seconds": {
          "$ref": "#/$defs/count",
          "description": "How long it was on screen or playing, to the last minute it saved"
        },
        "tracks": {
          "$ref": "#/$defs/count"
        },
        "playMinutes": {
          "$ref": "#/$defs/count"
        },
        "jams": {
          "$ref": "#/$defs/count"
        },
        "errorsDropped": {
          "$ref": "#/$defs/count"
        },
        "lyricsLookups": {
          "$ref": "#/$defs/count"
        },
        "lyricsSourceSynced": {
          "$ref": "#/$defs/count"
        },
        "lyricsThirdPartySynced": {
          "$ref": "#/$defs/count"
        },
        "lyricsSourceText": {
          "$ref": "#/$defs/count"
        },
        "lyricsThirdPartyText": {
          "$ref": "#/$defs/count"
        },
        "lyricsInstrumental": {
          "$ref": "#/$defs/count"
        },
        "lyricsNone": {
          "$ref": "#/$defs/count"
        },
        "lyricsThirdPartyFailed": {
          "$ref": "#/$defs/count"
        }
      },
      "dependentRequired": {
        "lyricsLookups": [
          "lyricsSourceSynced",
          "lyricsThirdPartySynced",
          "lyricsSourceText",
          "lyricsThirdPartyText",
          "lyricsInstrumental",
          "lyricsNone",
          "lyricsThirdPartyFailed"
        ]
      }
    },
    "androidCrash": {
      "title": "AndroidCrashEvent",
      "description": "The Android run named by session and version crashed: an uncaught exception, or a native crash Android reported; the next run sends this",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "session",
        "version",
        "signal",
        "frames",
        "seconds"
      ],
      "properties": {
        "type": {
          "const": "crash"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "signal": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
        },
        "frames": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/androidFrame"
          }
        },
        "seconds": {
          "$ref": "#/$defs/count",
          "description": "From a crash report, how long the process had run; from Android's report, how long the run was on screen or playing"
        },
        "exceptionType": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]{0,159}$",
          "description": "The root cause's class name"
        }
      }
    }
  }
}
